1(a): Implement the Breadth First Search (BFS) algorithm
---------------------------------------------------------------------
import queue as Q
from RMP import dict_gn # Ensure RMP.py is in the same directory

start = "Arad"
goal = "Bucharest"
result = ""

def BFS(city, cityq, visitedq):
    global result
    if city == start:
        result = result + " " + city

    for eachcity in dict_gn[city].keys():
        if eachcity == goal:
            result = result + " " + eachcity
            return

        if eachcity not in list(cityq.queue) and eachcity not in list(visitedq.queue):
            cityq.put(eachcity)
            result = result + " " + eachcity

    visitedq.put(city)

    if not cityq.empty():
        BFS(cityq.get(), cityq, visitedq)

def main():
    cityq = Q.Queue()
    visitedq = Q.Queue()

    BFS(start, cityq, visitedq)

    print("BFS Traversal From", start, "to", goal, "is:")
    print(result)

if __name__ == "__main__":
    main()

