2(b) Recursive Best-First Search
---------------------------------------------------------------------
import queue as Q
from RMP import dict_gn
from RMP import dict_hn

start = "Arad"
goal = "Bucharest"
result = ""

def get_fn(citystr):
  cities = citystr.split(",")

  gn = 0
  for i in range(len(cities) - 1):
    gn += dict_gn[cities[i]][cities[i + 1]]

  hn = dict_hn[cities[-1]]
  return gn + hn


def print_queue(cityq):
  for i in range(cityq.qsize()):
    print(cityq.queue[i])

def expand(cityq):
  global result

  if cityq.empty():
    return

  tot, citystr, thiscity = cityq.get()

  print("Expanded city:", thiscity)

  if thiscity == goal:
    result = citystr + "::" + str(tot)
    return

  tempq = Q.PriorityQueue()

  for cty in dict_gn[thiscity]:
    new_path = citystr + "," + cty
    tempq.put((get_fn(new_path), new_path, cty))

  # RBFS logic (best 2 candidates check)
  for _ in range(min(2, tempq.qsize())):
    f, path, node = tempq.get()
    cityq.put((f, path, node))
  print_queue(cityq)
  expand(cityq)

def main():
  cityq = Q.PriorityQueue()

  cityq.put((999, "", start))

  expand(cityq)

  print("Result of RBFS is:")
  print(result)

main()


